# Router SSH & Web Credentials Template
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

ROUTER_IP=192.168.1.1
ROUTER_PORT=222
ROUTER_USER=root
ROUTER_PASSWORD=your_ssh_password_here

# KeeneticOS Admin (Port 80/443)
KEENETIC_WEB_USER=admin
KEENETIC_WEB_PASS=your_admin_password_here
