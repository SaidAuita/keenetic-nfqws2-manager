<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Keenetic VPN"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пульт для Dune HD Smart TV"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙️"
                android:textSize="16sp"
                android:background="@drawable/btn_gray"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🔄"
                android:textSize="16sp"
                android:background="@drawable/btn_gray"
                android:textColor="@color/text_main"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- STATUS CONNECTION BANNER -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Подключение к роутеру 192.168.1.1:90..."
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="@drawable/badge_gray"
            android:layout_marginBottom="18dp" />

        <!-- DEVICE 1 CARD: DUNE КУХНЯ -->
        <LinearLayout
            android:id="@+id/cardDuneKuh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDuneKuhTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dune HD (Кухня)"
                        android:textColor="@color/text_main"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDuneKuhIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP: 192.168.1.145"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDuneKuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ВЫКЛ"
                    android:textColor="@color/btn_off_text"
                    android:background="@drawable/badge_gray"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuneKuhServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сервер: VLESS Reality"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKuhSmart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:text="🎯 Умный (YT)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_gray"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnKuhFull"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🛡️ Полный"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_gray"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnKuhOff"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="⚪ Выкл"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_off_text"
                    android:background="@drawable/btn_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- DEVICE 2 CARD: DUNE КОМНАТА -->
        <LinearLayout
            android:id="@+id/cardDuneKomnata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDuneKomnataTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dune HD (Комната)"
                        android:textColor="@color/text_main"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDuneKomnataIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP: 192.168.1.53"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeDuneKomnata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ВЫКЛ"
                    android:textColor="@color/btn_off_text"
                    android:background="@drawable/badge_gray"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuneKomnataServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сервер: VLESS Reality"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKomnataSmart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:text="🎯 Умный (YT)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_gray"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnKomnataFull"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🛡️ Полный"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_gray"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnKomnataOff"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="⚪ Выкл"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_off_text"
                    android:background="@drawable/btn_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- DYNAMIC DEVICES CONTAINER (for other devices) -->
        <LinearLayout
            android:id="@+id/containerOtherDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- BATCH CONTROLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Быстрые действия (все приставки)"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAllSmart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:text="🎯 Умный везде"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_green"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAllFull"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🛡️ Полный везде"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_purple"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAllOff"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="⚪ Выкл"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_off_text"
                    android:background="@drawable/btn_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- FOOTER INFO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Работает локально в домашней сети роутера Keenetic.\n🎯 Умный режим: YouTube через VPN, Кинопоиск/Иви напрямую."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
